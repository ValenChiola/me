---
const jobs = [
    {
        company: 'Crombie',
        date: 'Feb 2026 – Present',
        role: 'Senior Software Engineer, Software Engineer (Finch)',
        bullets: [
            'Part of the Integrations Team, owning the full lifecycle of every integration between upstream payroll providers and Finch\'s interfacing layer.',
            'Keep existing integrations stable and performant while expanding coverage and the number of integrations.',
            'Respond to breakages and alerts, and invest in automation that shrinks the maintenance load over time.',
        ],
    },
    {
        company: 'Egg Live',
        date: 'Jul 2021 – Feb 2026',
        role: 'Software Engineer',
        bullets: [
            'Contributed to Egg\'s Backoffice frontend development, enhancing user experience with React.',
            'Built a Fastify and Node.js API for student sign-ups from scratch, prioritizing performance and security.',
            'Led a microservices infrastructure development, ensuring seamless integration and scalability.',
        ],
    },
    {
        company: 'Egg Live',
        date: 'Jul 2021 – Jun 2022',
        role: 'Professor',
        bullets: [
            'Designed and delivered engaging lectures for an Egg course, fostering a dynamic learning environment.',
            'Guided students through practical applications of course material, contributing to their skill development.',
        ],
    },
];

const skillCategories = [
    {
        title: 'Backend',
        tags: ['Node.js', 'NestJS', 'Fastify', 'Express', 'TypeScript', 'Prisma', 'Socket Servers'],
    },
    {
        title: 'Frontend',
        tags: ['React + TypeScript', 'Next.js', 'TanStack (Query, Table, Router)', 'WebSockets'],
    },
    {
        title: 'Databases & Testing',
        tags: ['MySQL', 'MongoDB', 'Redis', 'Cypress', 'Jest', 'Vitest'],
    },
    {
        title: 'Cloud & Tooling',
        tags: ['AWS', 'Docker', 'Kubernetes', 'GitHub', 'GitLab'],
    },
];
---

<main class="main-content">
    <div class="section">
        <div class="section-title">Profile</div>
        <div class="profile-text">
            Senior Software Engineer with experience building and maintaining scalable web applications across the full
            stack. I work directly with React, Next.js, TypeScript, and modern frontend tools, while also developing
            and maintaining backend services, APIs, and database integrations. I have contributed to realtime features
            and complete solutions used by over 50,000 users. I focus on writing clean, maintainable code, ensuring
            solid architecture, and collaborating closely with diverse teams to deliver reliable products with lasting
            impact.
        </div>
    </div>

    <div class="section">
        <div class="section-title">Work Experience</div>
        {
            jobs.map((job) => (
                <div class="job-experience">
                    <div class="company-date">
                        <div class="company">{job.company}</div>
                        <div class="date">{job.date}</div>
                    </div>
                    <div class="role">{job.role}</div>
                    <ul>
                        {job.bullets.map((b) => (
                            <li>{b}</li>
                        ))}
                    </ul>
                </div>
            ))
        }
    </div>

    <div class="section skills-section">
        <div class="section-title">Technical Expertise</div>
        {
            skillCategories.map((cat) => (
                <div class="skills-category">
                    <div class="skills-category-title">{cat.title}</div>
                    <div class="skills-tags">
                        {cat.tags.map((t) => (
                            <span class="skill-tag">{t}</span>
                        ))}
                    </div>
                </div>
            ))
        }
    </div>
</main>

<style>
    .main-content {
        position: absolute;
        right: 0;
        top: 0;
        width: 14.5cm;
        height: 29.7cm;
        padding: 1.2cm 1cm;
        overflow: hidden;
    }

    .section {
        margin-bottom: 16px;
    }

    .section-title {
        font-size: 13pt;
        color: #2c3e50;
        margin-bottom: 8px;
        padding-bottom: 4px;
        border-bottom: 1px solid #ecf0f1;
        font-weight: 600;
        position: relative;
        padding-left: 15px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .section-title:before {
        content: '';
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 6px;
        height: 16px;
        background-color: #3498db;
        border-radius: 2px;
    }

    .profile-text {
        line-height: 1.4;
        color: #555;
        font-size: 9.5pt;
        text-align: justify;
        margin-bottom: 5px;
    }

    .job-experience {
        margin-bottom: 14px;
    }

    .company-date {
        display: flex;
        justify-content: space-between;
        margin-bottom: 3px;
        align-items: center;
    }

    .company {
        font-weight: bold;
        color: #2c3e50;
        font-size: 11pt;
    }

    .date {
        color: #3498db;
        font-weight: 500;
        background-color: #ecf0f1;
        padding: 1px 6px;
        border-radius: 10px;
        font-size: 8.5pt;
        white-space: nowrap;
    }

    .role {
        font-style: italic;
        color: #7f8c8d;
        margin-bottom: 6px;
        font-size: 10pt;
    }

    ul {
        padding-left: 16px;
        margin-top: 5px;
    }

    li {
        margin-bottom: 5px;
        color: #444;
        line-height: 1.35;
        font-size: 9.5pt;
    }

    .skills-section {
        margin-top: 10px;
    }

    .skills-category {
        margin-bottom: 10px;
    }

    .skills-category-title {
        font-size: 10pt;
        color: #2c3e50;
        font-weight: 600;
        margin-bottom: 4px;
    }

    .skills-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
    }

    .skill-tag {
        background-color: #f0f8ff;
        border: 1px solid #3498db;
        color: #2c3e50;
        padding: 3px 8px;
        border-radius: 12px;
        font-size: 8.5pt;
        font-weight: 500;
    }

    @media (max-width: 820px) {
        .main-content {
            position: relative;
            width: 100%;
            height: auto;
            padding: 24px 20px 40px;
        }

        .section-title {
            font-size: 16pt;
        }

        .company-date {
            flex-wrap: wrap;
            gap: 4px;
        }

        .company {
            font-size: 13pt;
        }

        .role {
            font-size: 12pt;
        }

        .date {
            font-size: 10pt;
        }

        .profile-text,
        li {
            font-size: 11pt;
            line-height: 1.5;
        }

        .skills-category-title {
            font-size: 12pt;
        }

        .skill-tag {
            font-size: 10pt;
            padding: 4px 10px;
        }
    }

    @media print {
        .main-content {
            position: absolute !important;
            right: 0 !important;
            top: 0 !important;
            width: 14.5cm !important;
            height: 29.7cm !important;
            padding: 1.2cm 1cm !important;
            overflow: visible !important;
        }

        .section-title {
            font-size: 12pt !important;
        }

        .company {
            font-size: 10pt !important;
        }

        .profile-text,
        li {
            font-size: 9pt !important;
        }

        .date {
            font-size: 8pt !important;
        }

        .skill-tag {
            font-size: 8pt !important;
        }
    }
</style>
