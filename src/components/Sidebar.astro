---
import { profileImage, contacts, languages } from "../data/sidebar";
---

<aside class="sidebar">
    <div class="profile-image-container">
        <img src={profileImage} alt="Valentino Chiola" class="profile-image" />
    </div>

    <h1 class="name">Valentino Chiola</h1>
    <p class="title-position">Senior Software Engineer</p>

    <section class="sidebar-section" aria-labelledby="contact-title">
        <h2 id="contact-title" class="sidebar-title">Contact</h2>
        <ul class="contact-info">
            {
                contacts.map(({ icon, href, label }) => (
                    <li class="contact-item">
                        <span class="contact-icon" aria-hidden="true">
                            {icon}
                        </span>
                        {href ? (
                            <a target="_blank" rel="noopener noreferrer" href={href}>
                                {label}
                            </a>
                        ) : (
                            <span>{label}</span>
                        )}
                    </li>
                ))
            }
        </ul>
    </section>

    <section class="sidebar-section" aria-labelledby="education-title">
        <h2 id="education-title" class="sidebar-title">Education</h2>
        <div class="education-item">
            <p class="university">Universidad Nacional de Mar del Plata</p>
            <p class="degree">Computer Engineering</p>
        </div>
    </section>

    <section class="sidebar-section" aria-labelledby="languages-title">
        <h2 id="languages-title" class="sidebar-title">Languages</h2>
        <ul class="languages-list">
            {languages.map((item) => <li class="language-item">{item}</li>)}
        </ul>
    </section>
</aside>

<style>
    .sidebar {
        position: absolute;
        left: 0;
        top: 0;
        width: 6.5cm;
        height: 29.7cm;
        background: linear-gradient(180deg, #2c3e50 0%, #3498db 100%);
        color: white;
        padding: 1.2cm 0.6cm;
        overflow: hidden;
    }

    .profile-image-container {
        text-align: center;
        width: 3.5cm;
        height: 3.5cm;
        border-radius: 50%;
        overflow: hidden;
        margin: 0 auto 15px;
        border: 0.15cm solid rgba(255, 255, 255, 0.3);
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.15);
    }

    .profile-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center 30%;
        transform: scale(1.3);
    }

    .name {
        font-size: 16pt;
        font-weight: bold;
        margin-bottom: 3px;
        text-align: center;
    }

    .title-position {
        font-size: 12pt;
        color: #ecf0f1;
        text-align: center;
        margin-bottom: 20px;
        font-weight: 300;
    }

    .sidebar-section {
        margin-bottom: 18px;
    }

    .sidebar-title {
        font-size: 12pt;
        font-weight: 600;
        margin-bottom: 8px;
        padding-bottom: 4px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    }

    .contact-info,
    .languages-list {
        list-style: none;
    }

    .contact-info {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .contact-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 8.5pt;
    }

    .contact-item a {
        color: white;
        text-decoration: none;
    }

    .contact-icon {
        width: 14px;
        height: 14px;
        color: #3498db;
        background-color: white;
        border-radius: 50%;
        padding: 2px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 8px;
    }

    .education-item {
        margin-bottom: 8px;
    }

    .university {
        font-weight: 500;
        font-size: 10pt;
        letter-spacing: 0.2px;
    }

    .degree {
        font-size: 9pt;
        color: #ecf0f1;
    }

    .language-item {
        font-size: 9pt;
        margin-bottom: 4px;
    }

    @media (max-width: 820px) {
        .sidebar {
            position: relative;
            width: 100%;
            height: auto;
            padding: 28px 20px;
        }

        .profile-image-container {
            width: 130px;
            height: 130px;
            margin-bottom: 14px;
        }

        .name {
            font-size: 22pt;
        }

        .title-position {
            font-size: 14pt;
            margin-bottom: 22px;
        }

        .sidebar-title {
            font-size: 14pt;
        }

        .contact-item,
        .language-item,
        .degree {
            font-size: 11pt;
        }

        .university {
            font-size: 12pt;
        }

        .contact-icon {
            width: 18px;
            height: 18px;
            font-size: 10px;
        }
    }

    @media print {
        .sidebar {
            position: absolute !important;
            left: 0 !important;
            top: 0 !important;
            width: 6.5cm !important;
            height: 29.7cm !important;
            background: #2c3e50 !important;
            padding: 1.2cm 0.6cm !important;
            -webkit-print-color-adjust: exact !important;
        }

        .name {
            font-size: 15pt !important;
        }

        .title-position {
            font-size: 11pt !important;
        }

        .sidebar-title {
            font-size: 11pt !important;
        }

        .contact-item,
        .language-item {
            font-size: 8pt !important;
        }
    }
</style>
